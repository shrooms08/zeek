# Public Zcash TESTNET lightwalletd endpoint (gRPC over TLS).
#
# Source: zec.rocks (https://zec.rocks), the community lightwalletd service
# funded by Zcash Community Grants; its status page https://hosh.zec.rocks
# lists the live testnet servers. Verified on 2026-10-13 with a gRPC
# GetLightdInfo call (chain_name = "test"). The former ECC endpoint
# lightwalletd.testnet.electriccoin.co:9067 no longer answers.
ZEEK_LIGHTWALLETD_URL=https://testnet.zec.rocks:443

# Where key material is written (gitignored). Default: ./.secrets
ZEEK_SECRETS_DIR=.secrets

# Where the wallet database is written (gitignored). Default: ./data
ZEEK_DATA_DIR=data

# Log verbosity for the CLI (tracing filter syntax).
RUST_LOG=info
