# Public Zcash TESTNET lightwalletd endpoint (gRPC over TLS).
#
# Source: zec.rocks (https://zec.rocks), the community lightwalletd service
# funded by Zcash Community Grants; its status page https://hosh.zec.rocks
# lists the live testnet servers. Verified on 2026-10-13 with a gRPC
# GetLightdInfo call (chain_name = "test"). The former ECC endpoint
# lightwalletd.testnet.electriccoin.co:9067 no longer answers.
ZEEK_LIGHTWALLETD_URL=https://testnet.zec.rocks:443

# Where key material is written (gitignored). Default: ./.secrets
ZEEK_SECRETS_DIR=.secrets

# Where the wallet database is written (gitignored). Default: ./data
ZEEK_DATA_DIR=data

# Log verbosity for the CLI (tracing filter syntax).
RUST_LOG=info

# --- zeek-engine ---
# Game config (committed, public). Default: config/game.testnet.json
ZEEK_GAME_CONFIG=config/game.testnet.json
# Engine database (gitignored). Default: data/zeek-engine.sqlite
ZEEK_ENGINE_DB=data/zeek-engine.sqlite
# HTTP API bind address. Default: 127.0.0.1:8787
ZEEK_ENGINE_BIND=127.0.0.1:8787
# Comma-separated allowed CORS origins; empty = no CORS headers.
ZEEK_ENGINE_CORS=
# drand relays queried for each bound round (first verifiable answer wins).
ZEEK_DRAND_RELAYS=https://api.drand.sh,https://api2.drand.sh,https://api3.drand.sh,https://drand.cloudflare.com
# Seconds between chain polls.
ZEEK_ENGINE_POLL_SECS=10
# Chain relay for browser wallets (/v1/chain/*, /v1/tx/*): requests per minute
# per client address. Set ZEEK_ENGINE_CORS to the harness origin, e.g.
# http://localhost:5173, so browsers may call it.
ZEEK_RELAY_RATE_PER_MIN=600

# --- zeek-dig (test players) ---
# Engine URL the player tool reads the board from.
ZEEK_ENGINE_URL=http://127.0.0.1:8787
# Player wallets live under ZEEK_SECRETS_DIR/players/<name>/ (gitignored).

# --- payout coordinator (zeek-engine, Phase 4) ---
# Keyholders as id=url=identity_pubkey_hex, comma-separated. Unset = no payouts.
ZEEK_KEYHOLDERS=1=http://127.0.0.1:9101=<hex>,2=http://127.0.0.1:9102=<hex>,3=http://127.0.0.1:9103=<hex>
# The coordinator's own ed25519 identity (zeek-keyholder identity-keygen --secrets-dir .secrets/coordinator).
ZEEK_COORDINATOR_IDENTITY=.secrets/coordinator/identity.json
# Vault public files (vault.json, payout-sealing.json) and the vault wallet database.
ZEEK_VAULT_SECRETS_DIR=.secrets
ZEEK_VAULT_DATA_DIR=data
ZEEK_VAULT_THRESHOLD=2
