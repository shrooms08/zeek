    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.5",
    "fake-indexeddb": "^6.2.4",
    "vite": "^7.1.12",
    "vitest": "^4.1.11"
  }
}
